generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  UNSELECTED
  STAFF
  OWNER
}

enum UserStatus {
  NEW
  PENDING
  ACTIVE
  SUSPENDED
  REMOVED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  requests           AccessRequest[]
  staffCredentials   StaffCredential[]
  roleChangeRequests RoleChangeRequest[]
  workspaces          WorkWorkspace[]
  attendanceRecords   AttendanceRecord[]
  attendanceHolidays  AttendanceHoliday[]
}

model WorkWorkspace {
  id           String        @id @default(cuid())
  name         String
  workspaceKey String        @unique
  passwordHash String
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions     WorkSession[]
  createdAt    DateTime      @default(now())
  @@index([companyId])
}

model WorkSession {
  id          String            @id @default(cuid())
  name        String
  workspaceId String
  workspace   WorkWorkspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     WorkSessionMember[]
  messages    WorkMessage[]
  createdAt   DateTime          @default(now())
  @@index([workspaceId])
}

model WorkSessionMember {
  sessionId String
  userId    String
  session   WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime    @default(now())
  @@id([sessionId, userId])
  @@index([userId])
}

model WorkMessage {
  id        String   @id @default(cuid())
  sessionId String
  session   WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  authorId  String
  authorName String
  body      String   @db.Text
  kind      String   @default("TEXT")
  createdAt DateTime @default(now())
  @@index([sessionId, createdAt])
}

model WorkQuickReply {
  userId  String @id
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies String[]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  image         String?
  emailVerified DateTime?

  passwordHash String?

  role   UserRole   @default(UNSELECTED)
  status UserStatus @default(NEW)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  accessRequests     AccessRequest[]
  roleChangeRequests RoleChangeRequest[]
  staffCredential    StaffCredential?
  workMemberships    WorkSessionMember[]
  workQuickReply     WorkQuickReply?
  attendanceRecords  AttendanceRecord[]
  accounts           Account[]
  sessions           Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([role])
  @@index([status])
}

model AttendanceRecord {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  status    AttendanceStatus
  createdAt DateTime @default(now())
  @@unique([userId, date])
  @@index([companyId, date])
}

model AttendanceHoliday {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  name      String   @default("Company holiday")
  createdAt DateTime @default(now())
  @@unique([companyId, date])
  @@index([companyId, date])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model GateAttempt {
  fingerprint  String    @id
  failures     Int       @default(0)
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt
}

model LoginAttempt {
  fingerprint  String    @id
  failures     Int       @default(0)
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt
}

model AccessRequest {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  status             RequestStatus @default(PENDING)
  requesterName      String?
  requesterEmail     String?
  contactNumber      String?
  whatsappNumber     String?
  message            String?
  notificationSentAt DateTime?

  requestedAt DateTime  @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?

  @@index([userId])
  @@index([companyId])
  @@index([status])
}

model StaffCredential {
  id                    String   @id @default(cuid())
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  infxName              String
  staffId               String
  passwordHash          String
  privateCodeHash       String
  passwordCiphertext    String?
  privateCodeCiphertext String?
  active                Boolean  @default(true)
  claimedByUserId       String?  @unique
  claimedByUser         User?    @relation(fields: [claimedByUserId], references: [id], onDelete: SetNull)
  createdAt             DateTime @default(now())

  @@unique([companyId, staffId])
  @@index([companyId, active])
}

model RoleChangeRequest {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status      RequestStatus @default(PENDING)
  requestedAt DateTime      @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?

  @@index([userId, status])
  @@index([companyId, status])
}
